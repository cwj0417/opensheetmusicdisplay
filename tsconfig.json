{
  "compilerOptions": {
    "target": "es2020",
    "esModuleInterop": true,
    "module": "commonjs",
    "noUnusedLocals": true,
    "rootDir": "./src",
    "outDir": "build/dist",
    "declaration": true,
    "sourceMap": true,
    "strict": false,
    "strictPropertyInitialization": false
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "demo",
    "build",
    "./src/VexFlowPatch/"
  ]
}
